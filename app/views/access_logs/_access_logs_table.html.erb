<div class="identify-logs-table-wrapper">
  <table class="identify-logs-table">
    <thead>
      <tr>
        <th><%= t("access_logs.index.headers.time") %></th>
        <th><%= t("access_logs.index.headers.identifier") %></th>
        <th><%= t("access_logs.index.headers.name") %></th>
        <th><%= t("access_logs.index.headers.course") %></th>
        <th><%= t("access_logs.index.headers.result") %></th>
        <% if policy(AccessLog).destroy? %>
          <th><%= t("access_logs.index.headers.actions") %></th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% logs.each do |log| %>
        <%= render "access_logs/row", log: log %>
      <% end %>
    </tbody>
  </table>
</div>
