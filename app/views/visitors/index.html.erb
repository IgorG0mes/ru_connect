<div class="resource-search-page">
  <div class="resource-search-header">
    <h1 class="resource-search-title"><%= t(".title") %></h1>
    <% if policy(Visitor).new? %>
      <%= link_to t(".new_link"), new_visitor_path, class: "identify-btn" %>
    <% end %>
  </div>

  <%= form_with url: visitors_path, method: :get, html: { class: "resource-search-form" } do |f| %>
    <p class="resource-search-hint"><%= t(".search_hint") %></p>
    <div class="identify-input-group">
      <%= f.text_field :q, value: params[:q], placeholder: t(".search_placeholder"),
            class: "identify-input", autofocus: true %>
      <%= f.submit t("shared.search"), class: "identify-btn identify-btn--inline" %>
    </div>
  <% end %>

  <turbo-frame id="visitors_list">
    <% if @searched %>
      <% if @visitors.any? %>
        <div class="resource-search-count">
          <%= t(".results_count", count: @total) %> &nbsp;|&nbsp; <%= t(".page", page: @page) %>
        </div>

        <div class="students-list">
          <% @visitors.each do |visitor| %>
            <%= render "visitors/visitor_row", visitor: visitor %>
          <% end %>
        </div>

        <div class="resource-pagination">
          <% if @page > 1 %>
            <%= link_to t(".previous"), visitors_path(q: params[:q], page: @page - 1),
                  class: "identify-btn", data: { turbo_frame: "visitors_list" } %>
          <% end %>
          <% if @has_more %>
            <%= link_to t(".next"), visitors_path(q: params[:q], page: @page + 1),
                  class: "identify-btn", data: { turbo_frame: "visitors_list" } %>
          <% end %>
        </div>
      <% else %>
        <p class="resource-search-empty"><%= t(".no_results", query: params[:q]) %></p>
      <% end %>
    <% end %>
  </turbo-frame>
</div>
