<div class="consulta-page">
  <% if @person %>
    <% header_class = "consulta-result-header consulta-result-header--#{@person_type == :student ? @person.status : 'visitor'}" %>
    <div class="consulta-result-card">
      <div class="<%= header_class %>">
        <div>
          <h2 class="consulta-result-name">
            <% if @person_type == :student %>🎓<% else %>👤<% end %>
            <%= @person.name %>
          </h2>
          <% if @person_type == :student %>
            <% badge_class = "consulta-status-badge consulta-status-badge--#{@person.status}" %>
            <span class="<%= badge_class %>">
              <%= case @person.status
                  when "active"    then "✅"
                  when "inactive"  then "⚠️"
                  when "suspended" then "🚫"
                  when "graduated" then "🏅"
                  end %>
              <%= t(".status.#{@person.status}") %>
            </span>
          <% else %>
            <span class="consulta-status-badge consulta-status-badge--visitor">
              <%= t(".visitor_badge") %>
            </span>
          <% end %>
        </div>
      </div>

      <div class="consulta-result-body">
        <div class="consulta-info-grid">
          <% if @person_type == :student %>
            <div class="consulta-info-item">
              <span class="consulta-info-label"><%= t(".course_label") %></span>
              <span class="consulta-info-value"><%= @person.course.presence || "—" %></span>
            </div>
            <div class="consulta-info-item">
              <span class="consulta-info-label"><%= t(".registration_label") %></span>
              <span class="consulta-info-value consulta-info-value--mono"><%= @person.registration %></span>
            </div>
          <% else %>
            <div class="consulta-info-item">
              <span class="consulta-info-label"><%= t(".email_label") %></span>
              <span class="consulta-info-value"><%= @person.email.presence || "—" %></span>
            </div>
          <% end %>
          <div class="consulta-info-item">
            <span class="consulta-info-label"><%= t(".balance_label") %></span>
            <span class="consulta-info-value consulta-info-value--balance">
              <%= t(".tickets_count", count: @person.ticket_balance) %>
            </span>
          </div>
        </div>

        <div class="consulta-logs-section">
          <h3 class="consulta-logs-title"><%= t(".logs_title") %></h3>
          <% if @recent_logs.empty? %>
            <p class="consulta-logs-empty"><%= t(".no_logs") %></p>
          <% else %>
            <ul class="consulta-logs-list">
              <% @recent_logs.each do |log| %>
                <% log_class = "consulta-log-item consulta-log-item--#{log.status}" %>
                <li class="<%= log_class %>">
                  <span class="consulta-log-date"><%= l(log.created_at, format: :short) %></span>
                  <span class="consulta-log-result"><%= log.access_result.presence || log.status.capitalize %></span>
                </li>
              <% end %>
            </ul>
          <% end %>
        </div>
      </div>

      <div class="consulta-result-footer">
        <div class="consulta-actions">
          <% if @unit_price %>
            <div data-controller="toggle" class="consulta-action">
              <button type="button" data-action="click->toggle#toggle" class="consulta-action-btn consulta-action-btn--buy">
                <span data-toggle-target="showLabel">🎟️ <%= t(".add_balance") %></span>
                <span data-toggle-target="hideLabel" style="display:none">✕ <%= t(".add_balance") %></span>
              </button>
              <div data-toggle-target="content" style="display:none" class="consulta-action-panel"
                   data-controller="ticket-calc" data-ticket-calc-unit-price-value="<%= @unit_price.to_f %>">
                <div class="ticket-buy-row">
                  <span class="ticket-buy-row-label"><%= t(".unit_price_label") %></span>
                  <span class="ticket-buy-row-value"><%= number_to_currency(@unit_price, unit: "R$", separator: ",", delimiter: ".") %></span>
                </div>
                <%= form_with url: payments_path, method: :post, data: { turbo: false } do |f| %>
                  <%= hidden_field_tag :payable_sgid, @person.to_sgid(for: "payment_topup").to_s %>
                  <label class="ticket-buy-label" for="quantity"><%= t(".quantity_label") %></label>
                  <div class="ticket-qty-stepper">
                    <button type="button" class="ticket-qty-btn" data-action="ticket-calc#decrement" aria-label="−">−</button>
                    <%= number_field_tag :quantity, 1,
                          id: "quantity",
                          step: 1,
                          min: 1,
                          max: Payment::MAX_QUANTITY,
                          inputmode: "numeric",
                          required: true,
                          class: "ticket-qty-input",
                          data: { "ticket-calc-target": "quantity", action: "input->ticket-calc#update" } %>
                    <button type="button" class="ticket-qty-btn" data-action="ticket-calc#increment" aria-label="+">+</button>
                  </div>
                  <div class="ticket-buy-row ticket-buy-row--total">
                    <span class="ticket-buy-row-label"><%= t(".total_label") %></span>
                    <strong class="ticket-buy-row-value" data-ticket-calc-target="total">—</strong>
                  </div>
                  <%= f.submit t(".pay_button"), class: "consulta-btn consulta-btn--full" %>
                <% end %>
              </div>
            </div>
          <% end %>
          <% if @person.qr_code_hash.present? %>
            <div data-controller="toggle" class="consulta-action">
              <button type="button" data-action="click->toggle#toggle" class="consulta-action-btn consulta-action-btn--qr">
                <span data-toggle-target="showLabel">📱 <%= t(".show_qr") %></span>
                <span data-toggle-target="hideLabel" style="display:none">✕ <%= t(".hide_qr") %></span>
              </button>
              <div data-toggle-target="content" style="display:none" class="consulta-action-panel consulta-qr-display">
                <%= @person.generate_qr_code_svg %>
              </div>
            </div>
          <% end %>
        </div>
        <%= link_to finder_path, class: "consulta-btn consulta-btn--outline consulta-btn--full" do %>
          ← <%= t(".back") %>
        <% end %>
      </div>
    </div>

  <% else %>
    <div class="consulta-hero">
      <div class="consulta-hero-icon">🔍</div>
      <h1 class="consulta-title"><%= t(".title") %></h1>
      <p class="consulta-subtitle"><%= t(".subtitle") %></p>
    </div>

    <%= form_with url: finder_path, method: :post, class: "consulta-form" do |f| %>
      <div class="consulta-input-group">
        <%= f.text_field :cpf,
              placeholder: t(".placeholder"),
              class: "consulta-input",
              autofocus: true,
              inputmode: "numeric",
              value: params[:cpf] %>
        <%= f.submit t(".submit"), class: "consulta-btn" %>
      </div>
    <% end %>

    <div class="consulta-secondary-actions">
      <%= link_to new_user_session_path, class: "consulta-secondary-btn consulta-secondary-btn--staff" do %>
        🔐 <%= t(".staff_login") %>
      <% end %>
      <% unless Date.current.saturday? || Date.current.sunday? %>
        <%= link_to public_menu_path, class: "consulta-secondary-btn consulta-secondary-btn--ghost" do %>
          🍽️ <%= t(".menu_link") %>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
