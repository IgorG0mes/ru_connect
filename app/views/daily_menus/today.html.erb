<div class="today-page">
  <div class="today-header">
    <div class="today-logo">🍽️</div>
    <h1 class="today-title"><%= t(".title", date: l(Date.current, format: '%A, %d de %B')) %></h1>
  </div>

  <% if @current_menu.present? %>
    <p class="today-meal-label"><%= t(".current_meal", meal: @current_menu.meal.name) %></p>
    <p class="today-hours"><%= t(".served_hours", start: @current_menu.meal.start_at.strftime('%H:%M'), end: @current_menu.meal.end_at.strftime('%H:%M')) %></p>

    <div class="today-menu-card">
      <div class="today-menu-item">
        <div class="today-menu-label"><%= t(".main_dish_label") %></div>
        <div class="today-menu-value"><%= @current_menu.main_dish %></div>
      </div>
      <hr class="form-divider">
      <div class="today-menu-item">
        <div class="today-menu-label"><%= t(".side_dish_label") %></div>
        <div class="today-menu-value"><%= @current_menu.side_dish %></div>
      </div>
      <% if @current_menu.salad.present? %>
        <hr class="form-divider">
        <div class="today-menu-item">
          <div class="today-menu-label"><%= t(".salad_label") %></div>
          <div class="today-menu-value"><%= @current_menu.salad %></div>
        </div>
      <% end %>
      <% if @current_menu.dessert.present? %>
        <hr class="form-divider">
        <div class="today-menu-item">
          <div class="today-menu-label"><%= t(".dessert_label") %></div>
          <div class="today-menu-value"><%= @current_menu.dessert %></div>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="today-footer">
    <%= link_to t(".access_link"), root_path, class: "today-access-link" %>
  </div>
</div>
