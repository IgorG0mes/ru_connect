<% content_for :head do %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Lora:wght@500;600&display=swap" rel="stylesheet">
<% end %>

<div class="today-page">
  <div class="today-header">
    <div class="today-logo">🍽️</div>
    <h1 class="today-title"><%= l(Date.current, format: '%A, %d de %B') %></h1>
  </div>

  <% if @menus.empty? %>
    <div class="today-empty">
      <p>📭</p>
      <p><%= t(".no_menu_today") %></p>
    </div>

  <% elsif @menus.size == 1 %>
    <% menu = @menus.first %>
    <div class="menu-single-card">
      <div class="menu-face-accent"></div>
      <%= render "daily_menus/menu_face_body", menu: menu %>
    </div>

  <% else %>
    <div class="menu-flip-scene"
         data-controller="menu-flip"
         data-menu-flip-initial-face-value="<%= @initial_face %>">

      <div class="menu-flip-tabs">
        <% @menus.each_with_index do |menu, i| %>
          <button class="menu-flip-tab <%= i == @initial_face ? 'menu-flip-tab--active' : '' %>"
                  data-menu-flip-target="tab"
                  data-face="<%= i %>"
                  data-action="click->menu-flip#flip">
            <%= i == 0 ? '☀️' : '🌙' %> <%= menu.meal.name %>
          </button>
        <% end %>
      </div>

      <div class="menu-flip-card <%= @initial_face > 0 ? 'is-flipped' : '' %>"
           data-menu-flip-target="card">

        <% @menus.each_with_index do |menu, i| %>
          <div class="menu-face menu-face--<%= i == 0 ? 'front' : 'back' %>">
            <div class="menu-face-accent"></div>
            <%= render "daily_menus/menu_face_body", menu: menu %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="today-footer">
    <%= link_to t(".access_link"), root_path, class: "today-access-link" %>
  </div>
</div>
