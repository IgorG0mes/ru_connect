<div class="today-page">
  <div class="today-header">
    <div class="today-logo">🍽️</div>
    <h1 class="today-title"><%= t(".title", date: l(Date.current, format: '%A, %d de %B')) %></h1>
  </div>

  <% if @current_menu.present? %>
    <p class="today-meal-label"><%= t(".current_meal", meal: @current_menu.meal.name) %></p>
    <p class="today-hours"><%= t(".served_hours", start: @current_menu.meal.start_at.strftime('%H:%M'), end: @current_menu.meal.end_at.strftime('%H:%M')) %></p>

    <div class="today-menu-card">
      <p class="form-section-title">🥩 <%= t(".section_protein") %></p>
      <div class="today-menu-item">
        <div class="today-menu-label"><%= DailyMenu.human_attribute_name(:animal_protein) %></div>
        <div class="today-menu-value"><%= @current_menu.animal_protein %></div>
      </div>
      <div class="today-menu-item">
        <div class="today-menu-label"><%= DailyMenu.human_attribute_name(:vegan_protein) %></div>
        <div class="today-menu-value"><%= @current_menu.vegan_protein %></div>
      </div>

      <hr class="form-divider">
      <p class="form-section-title">🍛 <%= t(".section_side_dish") %></p>
      <% [@current_menu.side_dish_one, @current_menu.side_dish_two, @current_menu.side_dish_three].select(&:present?).each do |dish| %>
        <div class="today-menu-item">
          <div class="today-menu-value"><%= dish %></div>
        </div>
      <% end %>

      <hr class="form-divider">
      <p class="form-section-title">🥗 <%= t(".section_salad") %></p>
      <% [@current_menu.salad_one, @current_menu.salad_two, @current_menu.salad_three].select(&:present?).each do |salad| %>
        <div class="today-menu-item">
          <div class="today-menu-value"><%= salad %></div>
        </div>
      <% end %>

      <hr class="form-divider">
      <p class="form-section-title">🍮 <%= t(".section_dessert") %></p>
      <% [@current_menu.dessert_one, @current_menu.dessert_two].select(&:present?).each do |dessert| %>
        <div class="today-menu-item">
          <div class="today-menu-value"><%= dessert %></div>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="today-footer">
    <%= link_to t(".access_link"), root_path, class: "today-access-link" %>
  </div>
</div>
