<%= form_with(model: daily_menu, html: { class: "form-card" }) do |form| %>
  <% if daily_menu.errors.any? %>
    <div class="form-errors">
      <div class="form-errors-title"><%= t(".errors", count: daily_menu.errors.count) %></div>
      <ul>
        <% daily_menu.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-field">
    <%= form.label :date, class: "form-label" %>
    <%= form.date_field :date, class: "form-input" %>
  </div>

  <div class="form-field">
    <%= form.label :meal_id, class: "form-label" %>
    <%= form.collection_select :meal_id, @meals, :id, :name, { prompt: t(".meal_prompt") }, { class: "form-input" } %>
  </div>

  <hr class="form-divider">

  <div class="form-field">
    <%= form.label :main_dish, class: "form-label" %>
    <%= form.text_field :main_dish, class: "form-input" %>
  </div>

  <div class="form-field">
    <%= form.label :side_dish, class: "form-label" %>
    <%= form.text_field :side_dish, class: "form-input" %>
  </div>

  <div class="form-field">
    <%= form.label :salad, class: "form-label" %>
    <%= form.text_field :salad, class: "form-input" %>
  </div>

  <div class="form-field">
    <%= form.label :dessert, class: "form-label" %>
    <%= form.text_field :dessert, class: "form-input" %>
  </div>

  <div class="form-actions">
    <%= form.submit t(".submit"), class: "form-submit" %>
  </div>
<% end %>
