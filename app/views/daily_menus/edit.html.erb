<div class="form-page">
  <div class="form-page-topbar">
    <%= link_to t(".back"), daily_menus_path, class: "profile-back-link" %>
  </div>

  <div class="form-page-header">
    <h1 class="form-page-title"><%= t(".title", date: l(@daily_menu.date)) %></h1>
    <p class="form-page-subtitle"><%= t(".subtitle") %></p>
  </div>

  <%= render "form", daily_menu: @daily_menu, meals: @meals %>
</div>
