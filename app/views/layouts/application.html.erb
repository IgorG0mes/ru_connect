<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || t(".app_title") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "mobile", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script src="<%= asset_path('html5-qrcode.min.js') %>" data-turbo-track="reload"></script>
  </head>

  <body>
    <div class="app-layout" data-controller="sidebar">
      <% if user_signed_in? %>
        <aside class="sidebar" data-sidebar-target="panel">
          <div class="sidebar-header">
            <button class="sidebar-link sidebar-toggle" data-action="click->sidebar#toggle">
              <span class="sidebar-icon">☰</span>
              <span class="sidebar-label"><%= t(".app_title") %></span>
            </button>
          </div>

          <div class="sidebar-user sidebar-link" style="cursor: default;">
            <span class="sidebar-icon">👤</span>
            <span class="sidebar-label"><%= current_user.username %></span>
          </div>

          <nav class="sidebar-nav">
            <% if policy(:access).index? %>
              <%= link_to identify_path, class: "sidebar-link" do %>
                <span class="sidebar-icon">🪪</span>
                <span class="sidebar-label"><%= t(".nav.identification") %></span>
              <% end %>
            <% end %>
            <% if policy(Student).index? %>
              <%= link_to students_path, class: "sidebar-link" do %>
                <span class="sidebar-icon">🎓</span>
                <span class="sidebar-label"><%= t(".nav.students") %></span>
              <% end %>
            <% end %>
            <% if policy(Visitor).index? %>
              <%= link_to visitors_path, class: "sidebar-link" do %>
                <span class="sidebar-icon">🧑</span>
                <span class="sidebar-label"><%= t(".nav.visitors") %></span>
              <% end %>
            <% end %>
            <% if policy(Meal).index? %>
              <%= link_to meals_path, class: "sidebar-link" do %>
                <span class="sidebar-icon">🍽️</span>
                <span class="sidebar-label"><%= t(".nav.meals") %></span>
              <% end %>
            <% end %>
            <% if policy(DailyMenu).index? %>
              <%= link_to daily_menus_path, class: "sidebar-link" do %>
                <span class="sidebar-icon">📋</span>
                <span class="sidebar-label"><%= t(".nav.daily_menus") %></span>
              <% end %>
            <% end %>
            <% if policy(AccessLog).index? %>
              <%= link_to access_logs_path, class: "sidebar-link" do %>
                <span class="sidebar-icon">📜</span>
                <span class="sidebar-label"><%= t(".nav.access_logs") %></span>
              <% end %>
            <% end %>
            <% if policy(User).index? %>
              <%= link_to roles_path, class: "sidebar-link" do %>
                <span class="sidebar-icon">🔑</span>
                <span class="sidebar-label"><%= t(".nav.roles") %></span>
              <% end %>
              <%= link_to users_path, class: "sidebar-link" do %>
                <span class="sidebar-icon">👥</span>
                <span class="sidebar-label"><%= t(".nav.users") %></span>
              <% end %>
              <%= link_to permissions_path, class: "sidebar-link" do %>
                <span class="sidebar-icon">🛡️</span>
                <span class="sidebar-label"><%= t(".nav.permissions") %></span>
              <% end %>
            <% end %>
          </nav>

          <div class="sidebar-footer">
            <%= link_to destroy_user_session_path, class: "sidebar-link sidebar-link--danger",
                  data: { turbo_method: :delete, turbo_confirm: t(".confirm_logout") } do %>
              <span class="sidebar-icon">🚪</span>
              <span class="sidebar-label"><%= t(".nav.logout") %></span>
            <% end %>
          </div>
        </aside>
      <% end %>

      <div class="sidebar-overlay"></div>

      <div class="main-wrapper">
        <% if user_signed_in? %>
          <div class="mobile-topbar">
            <button class="mobile-menu-btn" data-action="click->sidebar#toggle">☰</button>
            <span class="mobile-topbar-title"><%= t(".app_title") %></span>
          </div>
        <% end %>

        <div id="toast_container" class="toast-container">
          <% if notice %>
            <div class="toast toast-notice" data-controller="toast" data-action="click->toast#dismiss">
              <%= notice %>
            </div>
          <% end %>
          <% if alert %>
            <div class="toast toast-alert" data-controller="toast" data-action="click->toast#dismiss">
              <%= alert %>
            </div>
          <% end %>
        </div>

        <main class="main-content">
          <%= yield %>
        </main>
      </div>
    </div>
  </body>
</html>
