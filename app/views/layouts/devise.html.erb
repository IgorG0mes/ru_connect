<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "RU Connect" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "mobile", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="devise-body">
    <div id="toast_container" class="toast-container">
      <% if notice %>
        <div class="toast toast-notice" data-controller="toast" data-action="click->toast#dismiss">
          <%= notice %>
        </div>
      <% end %>
      <% if alert %>
        <div class="toast toast-alert" data-controller="toast" data-action="click->toast#dismiss">
          <%= alert %>
        </div>
      <% end %>
    </div>

    <%= yield %>
  </body>
</html>
