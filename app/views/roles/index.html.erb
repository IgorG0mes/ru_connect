<div class="resource-search-page">
  <div class="resource-search-header">
    <h1><%= t(".title") %></h1>
    <%= link_to t(".new_link"), new_role_path, class: "identify-btn" %>
  </div>

  <% if @roles.any? %>
    <div class="roles-list">
      <% @roles.each do |role| %>
        <%= render "roles/role_row", role: role %>
      <% end %>
    </div>
  <% else %>
    <p class="resource-search-empty"><%= t(".empty") %></p>
  <% end %>
</div>
