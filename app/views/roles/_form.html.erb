<%= form_with(model: role, html: { class: "form-card" }) do |form| %>
  <% if role.errors.any? %>
    <div class="form-errors">
      <div class="form-errors-title"><%= t(".errors", count: role.errors.count) %></div>
      <ul>
        <% role.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-field">
    <%= form.label :name, t(".name_label"), class: "form-label" %>
    <%= form.text_field :name, class: "form-input", placeholder: "Ex: admin, moderador..." %>
  </div>

  <div class="form-actions">
    <%= form.submit t(".submit"), class: "form-submit" %>
  </div>
<% end %>
