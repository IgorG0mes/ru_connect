<div class="resource-search-page">
  <div class="resource-search-header">
    <h1><%= t(".title") %></h1>
    <%= link_to t(".new_link"), new_meal_path, class: "identify-btn" %>
  </div>

  <% if @meals.any? %>
    <div class="meals-list">
      <% @meals.each do |meal| %>
        <%= render "meals/meal_row", meal: meal %>
      <% end %>
    </div>
  <% else %>
    <p class="resource-search-empty"><%= t(".empty") %></p>
  <% end %>
</div>
