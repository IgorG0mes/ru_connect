<%= form_with(model: meal, html: { class: "form-card" }) do |form| %>
  <% if meal.errors.any? %>
    <div class="form-errors">
      <div class="form-errors-title"><%= t(".errors", count: meal.errors.count) %></div>
      <ul>
        <% meal.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-field">
    <%= form.label :name, t(".name_label"), class: "form-label" %>
    <%= form.text_field :name, class: "form-input", placeholder: "Ex: Almoço, Jantar..." %>
  </div>

  <hr class="form-divider">

  <div class="form-field">
    <%= form.label :start_at, class: "form-label" %>
    <%= form.time_field :start_at, class: "form-input" %>
  </div>

  <div class="form-field">
    <%= form.label :end_at, class: "form-label" %>
    <%= form.time_field :end_at, class: "form-input" %>
  </div>

  <div class="form-actions">
    <%= form.submit t(".submit"), class: "form-submit" %>
  </div>
<% end %>
