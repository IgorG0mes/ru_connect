<div class="form-page">
  <div class="form-page-topbar">
    <%= link_to t(".back"), meals_path, class: "profile-back-link" %>
    <%= link_to t(".edit"), edit_meal_path(@meal), class: "identify-btn" %>
  </div>

  <div class="form-page-header">
    <h1 class="form-page-title"><%= t(".title", name: @meal.name) %></h1>
  </div>

  <div class="form-card">
    <div class="profile-field">
      <div class="profile-field-label"><%= Meal.human_attribute_name(:name) %></div>
      <div class="profile-field-value"><%= @meal.name %></div>
    </div>
    <hr class="form-divider">
    <div class="profile-field">
      <div class="profile-field-label"><%= Meal.human_attribute_name(:start_at) %></div>
      <div class="profile-field-value"><%= @meal.start_at.strftime('%H:%M') if @meal.start_at %></div>
    </div>
    <hr class="form-divider">
    <div class="profile-field">
      <div class="profile-field-label"><%= Meal.human_attribute_name(:end_at) %></div>
      <div class="profile-field-value"><%= @meal.end_at.strftime('%H:%M') if @meal.end_at %></div>
    </div>
  </div>
</div>
