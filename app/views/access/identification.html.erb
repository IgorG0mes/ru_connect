<div class="register-modal" data-controller="register-modal" style="display: none;">
  <div class="register-modal-backdrop" data-action="click->register-modal#close"></div>
  <div class="register-modal-box">
    <div class="register-modal-header">
      <h3><%= t(".register_modal.title") %></h3>
      <button class="qr-modal-close" data-action="click->register-modal#close">✕</button>
    </div>
    <p class="register-modal-desc"><%= t(".register_modal.description") %></p>
    <div class="register-modal-options">
      <%= link_to new_student_path, class: "register-option", data: { register_modal_target: "studentLink", turbo_frame: "_top" } do %>
        <span class="register-option-icon">🎓</span>
        <span class="register-option-label"><%= t(".register_modal.new_student") %></span>
      <% end %>
      <%= link_to new_visitor_path, class: "register-option", data: { register_modal_target: "visitorLink", turbo_frame: "_top" } do %>
        <span class="register-option-icon">🧑</span>
        <span class="register-option-label"><%= t(".register_modal.new_visitor") %></span>
      <% end %>
    </div>
  </div>
</div>

<div class="identify-page">
  <div class="identify-header">
    <h1 class="identify-title"><%= t(".title") %></h1>
    <p class="identify-subtitle"><%= t(".subtitle") %></p>
  </div>

  <div class="identify-panels">
    <div class="identify-panel">
      <div class="identify-panel-icon">🪪</div>
      <h2 class="identify-panel-title"><%= t(".cpf_panel.title") %></h2>
      <p class="identify-panel-desc"><%= t(".cpf_panel.description") %></p>

      <%= form_with url: identify_path, method: :post, html: { class: "identify-form" } do |f| %>
        <div class="identify-input-group">
          <%= f.text_field :identifier,
                autofocus: true,
                placeholder: t(".cpf_panel.placeholder"),
                class: "identify-input" %>
          <%= f.submit t(".cpf_panel.submit"), class: "identify-btn identify-btn--inline" %>
        </div>
      <% end %>
    </div>

    <div class="identify-divider">
      <span><%= t(".divider") %></span>
    </div>

    <div class="identify-panel" data-controller="qr-scanner"
          data-qr-scanner-url-value="<%= identify_path %>"
          data-qr-scanner-signed-in-value="<%= user_signed_in? %>"
          data-qr-scanner-login-url-value="<%= new_user_session_path %>">
      <div class="identify-panel-icon">📷</div>
      <h2 class="identify-panel-title"><%= t(".qr_panel.title") %></h2>
      <p class="identify-panel-desc"><%= t(".qr_panel.description") %></p>

      <button data-action="click->qr-scanner#start"
              data-qr-scanner-target="button"
              class="identify-btn identify-btn--secondary">
        <%= t(".qr_panel.start_scanner") %>
      </button>

      <div class="qr-modal" data-qr-scanner-target="modal" style="display: none;">
        <div class="qr-modal-backdrop" data-action="click->qr-scanner#reset"></div>
        <div class="qr-modal-box">
          <div class="qr-modal-header">
            <span><%= t(".qr_panel.modal_header") %></span>
            <button class="qr-modal-close" data-action="click->qr-scanner#reset">✕</button>
          </div>
          <div id="qr-reader" data-qr-scanner-target="reader"></div>
        </div>
      </div>
    </div>
  </div>

  <% if user_signed_in? %>
    <div class="identify-logs">
      <h2 class="identify-logs-title"><%= t(".logs.title") %></h2>

      <% if @today_logs.blank? %>
        <p class="identify-logs-empty"><%= t(".logs.empty") %></p>
      <% end %>
      <div class="access-log-feed" id="today_logs_body">
        <% @today_logs&.each do |log| %>
          <%= render "access_logs/log_card", log: log %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
