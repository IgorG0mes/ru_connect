<turbo-frame id="qr_code_student_<%= student.id %>">
  <div class="profile-card profile-card--qr">
    <div class="profile-card-title"><%= t(".title") %></div>

    <% if student.qr_code_hash.present? %>
      <div class="profile-qr-image">
        <%= student.generate_qr_code_svg %>
      </div>
      <div class="profile-qr-hash">
        <span class="profile-field-label"><%= t(".key_label") %></span>
        <code class="profile-qr-code"><%= student.qr_code_hash %></code>
      </div>
    <% else %>
      <p class="profile-qr-missing"><%= t(".not_generated") %></p>
    <% end %>

    <% if policy(student).regenerate_qr? %>
      <div class="profile-qr-actions">
        <%= link_to t(".regenerate"), regenerate_qr_student_path(student),
              data: { turbo_method: :post, turbo_confirm: t(".confirm_regenerate") },
              class: "identify-btn profile-qr-btn" %>
      </div>
    <% end %>
  </div>
</turbo-frame>
