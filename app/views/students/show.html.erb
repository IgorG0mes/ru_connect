<% avatar_colors = %w[#3b82f6 #8b5cf6 #ec4899 #f59e0b #10b981 #ef4444 #06b6d4 #6366f1] %>
<% avatar_color = avatar_colors[@student.name.ord % avatar_colors.length] %>
<% initials = @student.name.split.first(2).map { |w| w[0]&.upcase }.join %>

<div class="student-profile">
  <div class="student-profile-topbar">
    <%= link_to t(".back"), students_path, class: "profile-back-link" %>
    <div class="profile-topbar-actions">
      <% if policy(@student).edit? %>
        <%= link_to t(".edit"), edit_student_path(@student), class: "identify-btn" %>
      <% end %>
      <% if policy(@student).destroy? %>
        <%= link_to t(".delete"), student_path(@student),
              method: :delete,
              class: "profile-delete-btn",
              data: { turbo_method: :delete, turbo_confirm: t(".confirm_delete", name: @student.name) } %>
      <% end %>
    </div>
  </div>

  <div class="student-profile-hero">
    <div class="student-profile-avatar" style="background: <%= avatar_color %>">
      <%= initials %>
    </div>
    <div class="student-profile-hero-info">
      <h1 class="student-profile-name"><%= @student.name %></h1>
      <div class="student-profile-tags">
        <% if @student.course.present? %>
          <span class="student-card-tag"><%= @student.course %></span>
        <% end %>
        <% if @student.registration.present? %>
          <span class="student-card-tag"><%= t(".registration_abbr") %> <%= @student.registration %></span>
        <% end %>
        <% if @student.qr_code_hash.present? %>
          <span class="student-badge student-badge--active"><%= t(".qr_active") %></span>
        <% else %>
          <span class="student-badge student-badge--missing"><%= t(".qr_missing") %></span>
        <% end %>
      </div>
    </div>
  </div>

  <div class="student-profile-grid">
    <div class="profile-card">
      <div class="profile-card-title"><%= t(".personal_info") %></div>

      <div class="profile-field">
        <div class="profile-field-label"><%= Student.human_attribute_name(:registration) %></div>
        <div class="profile-field-value"><%= @student.registration.presence || t("shared.not_available") %></div>
      </div>

      <div class="profile-field">
        <div class="profile-field-label"><%= Student.human_attribute_name(:cpf) %></div>
        <div class="profile-field-value"><%= @student.cpf.presence || t("shared.not_available") %></div>
      </div>

      <div class="profile-field">
        <div class="profile-field-label"><%= Student.human_attribute_name(:email) %></div>
        <div class="profile-field-value"><%= @student.email.presence || t(".no_email") %></div>
      </div>

      <div class="profile-field">
        <div class="profile-field-label"><%= Student.human_attribute_name(:course) %></div>
        <div class="profile-field-value"><%= @student.course.presence || t("shared.not_available") %></div>
      </div>

      <div class="profile-field">
        <div class="profile-field-label"><%= t("tickets.label") %></div>
        <div class="profile-field-value profile-field-value--balance">
          <%= t("tickets.count", count: @student.ticket_balance) %>
        </div>
      </div>

      <div class="profile-field">
        <div class="profile-field-label"><%= t(".registered_at") %></div>
        <div class="profile-field-value"><%= l(@student.created_at, format: :long) %></div>
      </div>
    </div>

    <%= render "students/qr_code", student: @student %>
  </div>
</div>
