<%= form_with(model: student, html: { class: "form-card" }) do |form| %>
  <% if student.errors.any? %>
    <div class="form-errors">
      <div class="form-errors-title"><%= t(".errors", count: student.errors.count) %></div>
      <ul>
        <% student.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-field">
    <%= form.label :name, class: "form-label" %>
    <%= form.text_field :name, class: "form-input", placeholder: t(".name_placeholder") %>
  </div>

  <hr class="form-divider">

  <div class="form-field">
    <%= form.label :registration, class: "form-label" %>
    <%= form.text_field :registration, class: "form-input", placeholder: t(".registration_placeholder") %>
  </div>

  <div class="form-field" data-controller="cpf-validation">
    <%= form.label :cpf, class: "form-label" %>
    <%= form.text_field :cpf, class: "form-input", placeholder: t(".cpf_placeholder"),
          data: { cpf_validation_target: "input", action: "input->cpf-validation#validate" } %>
    <span data-cpf-validation-target="feedback" class="form-input-feedback"></span>
  </div>

  <hr class="form-divider">

  <div class="form-field">
    <%= form.label :email, class: "form-label" %>
    <%= form.email_field :email, class: "form-input", placeholder: t(".email_placeholder") %>
  </div>

  <div class="form-field">
    <%= form.label :course, class: "form-label" %>
    <%= form.text_field :course, class: "form-input", placeholder: t(".course_placeholder") %>
  </div>

  <div class="form-actions">
    <%= form.submit t(".submit"), class: "form-submit" %>
  </div>
<% end %>
